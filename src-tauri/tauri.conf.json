{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KB PDF Reader",
  "version": "0.1.0",
  "identifier": "com.barzick.kbpdfreader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "KB PDF Reader",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/": "pdfium/",
      "tessdata/": "tessdata/"
    },
    "copyright": "\u00a9 Kevin",
    "category": "Productivity",
    "shortDescription": "Lire, fusionner et modifier des PDF",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Document PDF",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ]
  }
}